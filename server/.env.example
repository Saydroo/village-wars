# Village Wars Backend — Umgebungsvariablen
# Kopiere nach `server/.env` und trage echte Werte ein.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# PostgreSQL — DATABASE_URL hat Vorrang vor den PG*-Einzelwerten
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/village_wars
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=village_wars

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OAuth — erlaubte Audiences (Komma-getrennt für mehrere)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
