# ─────────────────────────────────────────────────────────────────────────────
# Village Wars — Beispiel-Umgebungsvariablen (Wurzelebene)
# Kopiere diese Datei nach `server/.env` (Backend) bzw. nutze die Werte in
# `apps/mobile/.env`. Trage echte Werte ein. NICHT committen.
# ─────────────────────────────────────────────────────────────────────────────

# --- Backend (server/) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# PostgreSQL — entweder DATABASE_URL ODER die PG*-Einzelwerte setzen
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/village_wars
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=village_wars

# Redis (Cache/Session/Matchmaking)
REDIS_URL=redis://localhost:6379

# JWT — in Produktion durch lange Zufallswerte ersetzen
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OAuth — Audiences zum Verifizieren der Identity-Tokens
# Mehrere erlaubte Client-IDs mit Komma trennen
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Frontend (apps/mobile/) ---
# Muss mit EXPO_PUBLIC_ beginnen, damit Expo es im Client verfügbar macht
EXPO_PUBLIC_API_URL=http://localhost:4000
